local floatDragging = false; local floatDragStart = nil; local floatStartPos = nil; local floatMoved = false
floating.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        floatDragging = true; floatMoved = false; floatDragStart = input.Position; floatStartPos = floating.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then floatDragging = false end end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if floatDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - floatDragStart
        if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then floatMoved = true end
        floating.Position = UDim2.new(floatStartPos.X.Scale, floatStartPos.X.Offset + delta.X, floatStartPos.Y.Scale, floatStartPos.Y.Offset + delta.Y)
    end
end)
floating.InputEnded:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not floatMoved then
        SetVisible(true)
    end
end)

-- Keyboard Toggle
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    pcall(function()
        if input.KeyCode == (CONFIG.ToggleKey or Enum.KeyCode.RightShift) then
            SetVisible(not visible)
        elseif input.KeyCode == (Config.LockKey or Config.ToggleKey or Enum.KeyCode.Q) then
            AutoLockEnabled = not AutoLockEnabled
            Config.AimLockEnabled = AutoLockEnabled
            if AutoLockEnabled then SetTarget(FindBestTarget()) else SetTarget(nil) end
            Notify("Aim Lock", AutoLockEnabled and "Engine LOCKED" or "Engine STANDBY", AutoLockEnabled and T.Green or T.Text2)
        elseif input.KeyCode == (Config.SwitchKey or Enum.KeyCode.Tab) then
            if AutoLockEnabled then
                local enemies = GetEnemiesSortedByDistance()
                if #enemies > 1 then
                    for i, entry in ipairs(enemies) do
                        if entry.Character == CurrentTargetChar then
                            local nextIdx = (i % #enemies) + 1
                            SetTarget(enemies[nextIdx])
                            Notify("Target Switched", enemies[nextIdx].Name, T.Cyan)
                            return
                        end
                    end
                    SetTarget(enemies[1])
                end
            end
        elseif input.KeyCode == (Config.SilentAimKey or Config.BulletToggleKey or Enum.KeyCode.T) then
            Config.BulletTrackingEnabled = not Config.BulletTrackingEnabled
            Config.SilentAimEnabled = Config.BulletTrackingEnabled
            _G.FeathCombatConfig = Config
            Notify("Silent Aim", Config.BulletTrackingEnabled and "Enabled" or "Disabled", Config.BulletTrackingEnabled and T.Green or T.Text2)
        end
    end)
end)

