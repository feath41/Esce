    local function set(v, animate)
        on = v
        state.Text = on and "ENABLED" or "STANDBY"; state.TextColor3 = on and T.Blue2 or T.Text3
        local pos = on and UDim2.new(1, -19, 0.5, -8) or UDim2.fromOffset(3, 3)
        if animate then
            Tween(btn, 0.14, {BackgroundColor3 = on and T.Blue or T.Track})
            Tween(knob, 0.14, {Position = pos})
            Tween(bst, 0.14, {Color = on and T.Blue2 or T.Border})
            Tween(iconBox, 0.14, {BackgroundColor3 = on and T.DeepBlue or T.Surface2})
