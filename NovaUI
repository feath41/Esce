SwitchPage = function(name)
    if CloseAllDropdowns then CloseAllDropdowns() end
    if not pages[name] then return end
    activePage = name
    for id, data in pairs(nav) do
        local on = (id == name)
        Tween(data.button, 0.16, {BackgroundColor3 = on and T.DeepBlue or T.Surface, BackgroundTransparency = on and 0.12 or 1})
        Tween(data.bar, 0.16, {BackgroundTransparency = on and 0 or 1})
        Tween(data.icon, 0.16, {TextColor3 = on and T.Blue2 or T.Text3})
        Tween(data.text, 0.16, {TextColor3 = on and T.Text or T.Text2})
        Tween(data.dot, 0.16, {BackgroundTransparency = on and 0 or 1})
    end
    for id, p in pairs(pages) do p.Visible = (id == name) end
    local p = pages[name]
    if p then
        p.Position = UDim2.new(0, 8, 0, 0)
        Tween(p, 0.18, {Position = UDim2.new(0, 0, 0, 0)})
    end
end

