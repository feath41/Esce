                        if math.random(1, 100) <= hitChance then
                            local fn = _G.FeathGetBulletTarget
                            local targetPart, targetPos = fn and fn()
                            if targetPart and targetPos then
                                if key == "Hit" then return CFrame.new(targetPos)
                                elseif key == "Target" then return targetPart end
                            end
                        end
                    end
                end
                return oldIndex(self, key)
            end))
        end
    end
end)

-- Physical Projectile Homing
local function MonitorProjectile(obj)
    if not Config.BulletTrackingEnabled or not Config.BulletHomingProjectiles then return end
    if not obj or not obj:IsA("BasePart") then return end
    local myChar = LocalPlayer.Character
    if not myChar or obj:IsDescendantOf(myChar) then return end
    if obj.Name == "CombatBulletTracer" or obj.Name == "CombatTargetHitboxBox" or obj.Name == "CombatTargetHitboxHighlight" then return end

    local lowerName = string.lower(obj.Name)
    local isProj = string.find(lowerName, "bullet") or string.find(lowerName, "projectile") or string.find(lowerName, "rocket") or string.find(lowerName, "arrow") or string.find(lowerName, "laser")
    if isProj or (not obj.Anchored and obj.Size.Magnitude < 6) then
        local targetPart, targetPos = GetBulletTarget()
        if not targetPart or not targetPos then return end
        local conn
        local startT = tick()
        conn = RunService.Heartbeat:Connect(function(dt)
            pcall(function()
                if not obj or not obj.Parent or (tick() - startT > 3.0) then
                    if conn then conn:Disconnect() end
                    return
                end
                local currentT = GetTargetPart(CurrentTargetChar) or targetPart
                if currentT and currentT.Parent then
                    local dir = (currentT.Position - obj.Position).Unit
                    local speed = obj.AssemblyLinearVelocity.Magnitude
                    if speed < 30 then speed = 120 end
                    obj.AssemblyLinearVelocity = dir * speed
                    obj.CFrame = CFrame.lookAt(obj.Position, currentT.Position)
                end
            end)
        end)
    end
end
_G.CombatBulletProjectileConn = workspace.DescendantAdded:Connect(function(descendant)
    pcall(function() MonitorProjectile(descendant) end)
end)

-- AutoShoot / TriggerBot
local function IsTargetVisible(targetPart)
    if not targetPart or not targetPart:IsA("BasePart") then return false end
    local myChar = LocalPlayer.Character
    if not myChar then return false end
    local origin = Camera.CFrame.Position
    local dir = targetPart.Position - origin
    if dir.Magnitude < 0.5 then return true end

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {myChar, targetPart.Parent, Camera}
    local res = workspace:Raycast(origin, dir, rayParams)
    return res == nil
end

local function GetAutoShootTarget()
    local myChar = LocalPlayer.Character
    if not myChar then return nil end

    if AutoLockEnabled and CurrentTargetChar and CurrentTargetPart and IsValidEnemy(CurrentTargetChar) then
        if not Config.AutoShootWallCheck or IsTargetVisible(CurrentTargetPart) then
            return CurrentTargetPart
        end
    end

    local enemies = GetEnemiesSortedByDistance()
    local centerPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local fovRad = Config.BulletFOVRadius or 180

    for _, entry in ipairs(enemies) do
        local model = entry.Character
        local part = nil
        if Config.TargetPartChoice == "Head" then
            part = model:FindFirstChild("Head") or entry.Part
        else
            part = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or entry.Part
        end
        if part and part:IsA("BasePart") then
            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - centerPos).Magnitude
                if screenDist <= fovRad then
                    if not Config.AutoShootWallCheck or IsTargetVisible(part) then
                        return part
                    end
                end
            end
        end
    end
    return nil
end

local function TriggerShoot()
    local now = tick()
    local delaySec = (Config.AutoShootDelayMs or 100) / 1000
    if now - lastAutoShootTick < delaySec then return end
    lastAutoShootTick = now

    pcall(function()
        local myChar = LocalPlayer.Character
        if not myChar then return end

        local tool = myChar:FindFirstChildOfClass("Tool")
        if tool then
            tool:Activate()
        end

        if typeof(mouse1click) == "function" then
            pcall(mouse1click)
        elseif typeof(mouse1press) == "function" and typeof(mouse1release) == "function" then
            pcall(function()
                mouse1press()
                task.delay(0.02, function() pcall(mouse1release) end)
            end)
        end

        local vim = nil
        pcall(function() vim = game:GetService("VirtualInputManager") end)
        if vim then
            local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            pcall(function()
                vim:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 1)
                task.delay(0.02, function()
                    pcall(function() vim:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 1) end)
                end)
            end)
        end
    end)
end

-- Teleport & Fly
local function StopFly(msg, col)
    isFlying = false
    if flyHeartbeatConn then flyHeartbeatConn:Disconnect(); flyHeartbeatConn = nil end
    if flyNoclipConn then flyNoclipConn:Disconnect(); flyNoclipConn = nil end
    pcall(function()
        local myChar = LocalPlayer.Character
        local root = myChar and GetTargetPart(myChar)
        if root then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end)
    if msg then Notify("Fly System", msg, col or T.Cyan) end
end

local function ResolveActiveTarget()
    if CurrentTargetChar and IsValidEnemy(CurrentTargetChar) then
        return CurrentTargetChar
    end
    local best = FindBestTarget()
    if best and best.Character and IsValidEnemy(best.Character) then
        SetTarget(best)
        return best.Character
    end
    local enemies = GetEnemiesSortedByDistance()
    if #enemies > 0 and enemies[1].Character and IsValidEnemy(enemies[1].Character) then
        SetTarget(enemies[1])
        return enemies[1].Character
    end
    return nil
end

local function ExecuteTeleport()
    pcall(function()
        local targetChar = ResolveActiveTarget()
        if not targetChar then
            Notify("Teleport Error", "Tidak ada musuh dalam jangkauan jarak!", T.Red)
            return
        end
        local myChar = LocalPlayer.Character
        local myRoot = myChar and GetTargetPart(myChar)
        local tRoot = GetTargetPart(targetChar)
        if myRoot and tRoot then
            local behindPos = tRoot.CFrame * CFrame.new(0, 2, 3.5)
            myRoot.CFrame = CFrame.lookAt(behindPos.Position, tRoot.Position)
            Notify("Teleport", "Berhasil teleport ke belakang musuh!", T.Green)
        end
    end)
end

local function ToggleFly()
    if isFlying then StopFly("Terbang dinonaktifkan.", T.Yellow); return end
    local targetChar = ResolveActiveTarget()
    if not targetChar then
        Notify("Fly Error", "Tidak ada musuh dalam jangkauan jarak!", T.Red)
        return
    end
    isFlying = true
    Notify("Fly System", "Mode terbang ke target aktif.", T.Green)

    flyNoclipConn = RunService.Stepped:Connect(function()
        pcall(function()
            local myChar = LocalPlayer.Character
            if myChar then
                for _, part in ipairs(myChar:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end)
    end)

    flyHeartbeatConn = RunService.Heartbeat:Connect(function(dt)
        pcall(function()
            if not isFlying then StopFly(); return end
            local myChar = LocalPlayer.Character
            local myRoot = myChar and GetTargetPart(myChar)
            if not myRoot or not targetChar or not targetChar.Parent or not IsValidEnemy(targetChar) then
                StopFly("Target hilang atau mati!", T.Red); return
            end
            local tRoot = GetTargetPart(targetChar)
            if not tRoot then StopFly(); return end
            local targetPos = tRoot.Position + Vector3.new(0, 2, 0)
            local diff = targetPos - myRoot.Position
            local dist = diff.Magnitude
            if dist <= 4.5 then StopFly("Tiba di posisi target!", T.Green); return end
            local step = math.min(dist, Config.FlySpeed * dt)
            myRoot.AssemblyLinearVelocity = Vector3.zero
            myRoot.AssemblyAngularVelocity = Vector3.zero
            myRoot.CFrame = CFrame.lookAt(myRoot.Position + (diff.Unit * step), targetPos)
        end)
    end)
end

