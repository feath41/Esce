pcall(function()
    local extGui = New("ScreenGui", {
        Name = "CombatNovaExternalGui",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 9999,
        Enabled = Config.ExternalControlsEnabled,
    }, SafeParent)

    local extFrame = New("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1}, extGui)
    local joySize = Config.ExternalControlsSize or 120
    local jBase = New("Frame", {
        Name = "ExternalJoystickBase",
        Size = UDim2.fromOffset(joySize, joySize),
        Position = UDim2.new(0, 40, 1, -joySize - 40),
        BackgroundColor3 = Color3.fromRGB(15, 18, 26), BackgroundTransparency = 0.45,
    }, extFrame); Corner(jBase, 999); Stroke(jBase, T.Blue, 0.35, 2)

    local jKnob = New("Frame", {
        Name = "ExternalJoystickKnob",
        Size = UDim2.fromOffset(math.floor(joySize * 0.44), math.floor(joySize * 0.44)),
        Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = T.Blue, BackgroundTransparency = 0.2,
    }, jBase); Corner(jKnob, 999); Stroke(jKnob, T.White, 0.2, 2)

    local jumpSize = Config.ExternalJumpSize or 72
    local jBtn = Button(extFrame, {
        Name = "ExternalJumpButton",
        Size = UDim2.fromOffset(jumpSize, jumpSize),
        Position = UDim2.new(1, -jumpSize - 40, 1, -jumpSize - 55),
        BackgroundColor3 = Color3.fromRGB(15, 18, 26), BackgroundTransparency = 0.35,
        Text = "JUMP\n▲", TextColor3 = T.White, Font = F.Bold, TextSize = 11,
    })
    Corner(jBtn, 999); Stroke(jBtn, T.Blue, 0.3, 2)

    local thumbstickVector = Vector2.zero
    local activeJoystickTouch = nil
    local isJumping = false

    local function UpdateKnobPosition(inputPos)
        pcall(function()
            local basePos = jBase.AbsolutePosition
            local baseSize = jBase.AbsoluteSize
            local center = basePos + (baseSize / 2)
            local maxRadius = math.max((baseSize.X / 2) - 4, 1)

            local delta = inputPos - center
            local dist = delta.Magnitude
            if dist > maxRadius then
                delta = delta.Unit * maxRadius
            end

            jKnob.Position = UDim2.new(0.5, delta.X, 0.5, delta.Y)
            thumbstickVector = Vector2.new(delta.X / maxRadius, delta.Y / maxRadius)
        end)
    end

    local function ResetKnobPosition()
        pcall(function()
            activeJoystickTouch = nil
            thumbstickVector = Vector2.zero
            Tween(jKnob, 0.12, {Position = UDim2.new(0.5, 0, 0.5, 0)})
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then hum:Move(Vector3.zero, false) end
        end)
    end

    jBase.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            if not activeJoystickTouch then
                activeJoystickTouch = input
                UpdateKnobPosition(Vector2.new(input.Position.X, input.Position.Y))
            end
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if activeJoystickTouch and input == activeJoystickTouch then
            UpdateKnobPosition(Vector2.new(input.Position.X, input.Position.Y))
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if activeJoystickTouch and input == activeJoystickTouch then
            ResetKnobPosition()
        end
    end)

    jBtn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            isJumping = true
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                hum.Jump = true
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end)

    jBtn.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            isJumping = false
        end
    end)

    RunService.RenderStepped:Connect(function()
        pcall(function()
            if not Config.ExternalControlsEnabled then return end
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then return end

            if thumbstickVector and thumbstickVector.Magnitude > 0.05 then
                local cam = workspace.CurrentCamera
                if cam then
                    local look = cam.CFrame.LookVector
                    local right = cam.CFrame.RightVector
                    local flatLook = Vector3.new(look.X, 0, look.Z).Unit
                    local flatRight = Vector3.new(right.X, 0, right.Z).Unit
                    local moveDir = (flatRight * thumbstickVector.X) + (flatLook * (-thumbstickVector.Y))
                    hum:Move(moveDir, false)
                end
            end

            if isJumping then
                hum.Jump = true
            end
        end)
    end)
end)

