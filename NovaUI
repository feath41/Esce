local function Dropdown(parent, title, desc, options, defaultVal, callback)
    options = options or {}
    local selectedVal = defaultVal or options[1] or "Pilih..."
    local isOpen = false

    local card = New("Frame", {Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = T.Card, ClipsDescendants = true}, parent)
    Corner(card, 7); local st = Stroke(card, T.Border, 0.25)

    Label(card, title, UDim2.new(0.52, 0, 0, 14), UDim2.fromOffset(12, 9), F.Semi, T.Text, 10)
    Label(card, desc, UDim2.new(0.52, 0, 0, 10), UDim2.fromOffset(12, 26), F.Regular, T.Text3, 7)

    local selBtn = Button(card, {Size = UDim2.fromOffset(124, 28), Position = UDim2.new(1, -132, 0, 12), BackgroundColor3 = T.DeepBlue, Text = tostring(selectedVal) .. "  ▾", TextColor3 = T.Blue2, Font = F.Bold, TextSize = 9})
    Corner(selBtn, 5); local selStroke = Stroke(selBtn, T.Blue, 0.35)

    local optCount = #options
    local optHeight = 24
    local optSpacing = 2
    local totalListHeight = optCount * (optHeight + optSpacing) + 6

    local optList = New("Frame", {Size = UDim2.new(1, -20, 0, totalListHeight), Position = UDim2.fromOffset(10, 48), BackgroundColor3 = T.Panel, ClipsDescendants = true, Visible = false}, card)
    Corner(optList, 6); Stroke(optList, T.Border2, 0.35)
    Layout(optList, nil, optSpacing)
    Padding(optList, 3, 3, 3, 3)

    local optButtons = {}
    local function updateVisuals()
        for _, item in ipairs(optButtons) do
            local isSel = (item.Val == selectedVal)
            if isSel then
                item.Btn.BackgroundColor3 = T.DeepBlue
                item.Btn.TextColor3 = T.Blue2
                item.Btn.Text = "  ✓  " .. item.Name
                item.Btn.Font = F.Bold
            else
                item.Btn.BackgroundColor3 = T.Card
                item.Btn.TextColor3 = T.Text2
                item.Btn.Text = "      " .. item.Name
                item.Btn.Font = F.Regular
            end
        end
    end

    local function closeDropdown()
        if not isOpen then return end
        isOpen = false
        optList.Visible = false
        selBtn.Text = tostring(selectedVal) .. "  ▾"
        selStroke.Color = T.Blue
        st.Color = T.Border
        card.Size = UDim2.new(1, 0, 0, 52)
        if activeDropdownCloser == closeDropdown then
            activeDropdownCloser = nil
        end
    end

    local function openDropdown()
        CloseAllDropdowns()
        isOpen = true
        activeDropdownCloser = closeDropdown
        selBtn.Text = tostring(selectedVal) .. "  ▲"
        selStroke.Color = T.Blue2
        st.Color = T.Border2
        optList.Visible = true
        card.Size = UDim2.new(1, 0, 0, 52 + totalListHeight + 6)
    end

    selBtn.MouseButton1Click:Connect(function()
        if isOpen then closeDropdown() else openDropdown() end
    end)

    for _, opt in ipairs(options) do
        local optName = tostring(opt)
        local btn = Button(optList, {Size = UDim2.new(1, 0, 0, optHeight), BackgroundColor3 = T.Card, Text = "      " .. optName, TextColor3 = T.Text2, Font = F.Regular, TextSize = 8, TextXAlignment = Enum.TextXAlignment.Left})
        Corner(btn, 4)
        btn.MouseEnter:Connect(function()
            if opt ~= selectedVal then
                Tween(btn, 0.08, {BackgroundColor3 = T.Hover, TextColor3 = T.Text})
            end
        end)
        btn.MouseLeave:Connect(function()
            if opt ~= selectedVal then
                Tween(btn, 0.08, {BackgroundColor3 = T.Card, TextColor3 = T.Text2})
            end
        end)
        btn.MouseButton1Click:Connect(function()
            selectedVal = opt
            updateVisuals()
            closeDropdown()
            if callback then callback(opt) end
        end)
        table.insert(optButtons, {Name = optName, Val = opt, Btn = btn})
    end

    updateVisuals()
    return card
end

