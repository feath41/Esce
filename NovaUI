-- 2. SAFE GUI PARENT (DELTA EXECUTOR, ARCEUS X, CODEX, COREGUI & STUDIO)
-- ============================================================================
local function GetSafeGuiParent(guiInstance)
    local targetParent = nil
    pcall(function()
        if typeof(gethui) == "function" then
            targetParent = gethui()
        end
    end)
    if guiInstance then
        pcall(function()
            if typeof(syn) == "table" and typeof(syn.protect_gui) == "function" then
                syn.protect_gui(guiInstance)
            end
        end)
    end
    if not targetParent then
        pcall(function()
            local coreGui = game:GetService("CoreGui")
            if coreGui then
                local testFolder = Instance.new("Folder")
                testFolder.Parent = coreGui
                testFolder:Destroy()
                targetParent = coreGui
            end
        end)
    end
    if not targetParent then
        pcall(function()
            targetParent = LocalPlayer:WaitForChild("PlayerGui", 5) or (LocalPlayer and LocalPlayer.PlayerGui)
        end)
    end
    return targetParent or game:GetService("CoreGui")
end

