-- 15. MAIN RENDERSTEPPED LOOP & DIAGNOSTICS
-- ============================================================================
local frames, elapsed = 0, 0
RunService.RenderStepped:Connect(function(dt)
    frames += 1; elapsed += dt
    if elapsed >= 0.5 then
        local fps = math.floor(frames / elapsed)
        local ping = 0
        pcall(function() ping = math.floor(LocalPlayer:GetNetworkPing() * 1000) end)
        if ping < 0 then ping = 0 end
        fpsPingLabel.Text = string.format("FPS %d   •   PING %dms", fps, ping)
        frames = 0; elapsed = 0
    end

    pcall(function()
        -- 1. Update UI Diagnostic Displays
        if AutoLockEnabled then
            readyPill.BackgroundColor3 = T.DeepBlue
            readyDot.BackgroundColor3 = T.Blue2
            readyLabel.Text = "LOCKED"
            readyLabel.TextColor3 = T.Blue2
            sLock.Value.Text = "LOCKED"
            sLock.Value.TextColor3 = T.Blue2
            sysDot.BackgroundColor3 = T.Blue2
            sysStatusLabel.Text = "AimLock: ACTIVE"
        else
            readyPill.BackgroundColor3 = T.Card
            readyDot.BackgroundColor3 = T.Green
            readyLabel.Text = "READY"
            readyLabel.TextColor3 = T.Green
            sLock.Value.Text = "STANDBY"
            sLock.Value.TextColor3 = T.Green
            sysDot.BackgroundColor3 = T.Green
            sysStatusLabel.Text = "AimLock: OFF"
        end

        sTracking.Value.Text = (Config.BulletTrackingEnabled or Config.SilentAimEnabled) and "ACTIVE" or "STANDBY"
        sTracking.Value.TextColor3 = (Config.BulletTrackingEnabled or Config.SilentAimEnabled) and T.Cyan or T.Text3

        if CurrentTargetChar and IsValidEnemy(CurrentTargetChar) then
            local isPlr, plrObj = IsPlayerCharacter(CurrentTargetChar)
            local nameStr = isPlr and (plrObj.DisplayName ~= "" and plrObj.DisplayName or plrObj.Name) or CurrentTargetChar.Name
            local myChar = LocalPlayer.Character
            local myRoot = myChar and GetTargetPart(myChar)
            local tRoot = GetTargetPart(CurrentTargetChar)
            local dist = (myRoot and tRoot) and (tRoot.Position - myRoot.Position).Magnitude or 0
            local hum = CurrentTargetChar:FindFirstChildOfClass("Humanoid")
            local curHp = hum and hum.Health or 100
            local maxHp = hum and hum.MaxHealth or 100
            local hpRatio = math.clamp(curHp / (maxHp > 0 and maxHp or 100), 0, 1)

            tNameLbl.Text = "TARGET: " .. string.upper(nameStr)
            tDistLbl.Text = string.format("Distance: %.0f studs  •  HP: %.0f/%.0f (%.0f%%)", dist, curHp, maxHp, hpRatio * 100)
            hpFill.Size = UDim2.new(hpRatio, 0, 1, 0)
            hpFill.BackgroundColor3 = hpRatio > 0.5 and T.Green or (hpRatio > 0.25 and T.Yellow or T.Red)
            sTarget.Value.Text = string.sub(nameStr, 1, 14)
            sTarget.Detail.Text = string.format("%.0f studs away", dist)
        else
            tNameLbl.Text = "TARGET: NONE"
            tDistLbl.Text = "Distance: -- studs  •  Type: --"
            hpFill.Size = UDim2.new(0, 0, 1, 0)
            sTarget.Value.Text = "NONE"
            sTarget.Detail.Text = "No enemy locked"
        end

        -- 2. FOV Circle Update
        local isFOVOn = (Config.BulletShowFOVCircle ~= false) and (Config.ShowFOVCircle ~= false)
        local shouldShowFOV = (Config.BulletTrackingEnabled or Config.AutoShootEnabled or AutoLockEnabled) and isFOVOn and (Config.BulletUseFOV ~= false)
        if shouldShowFOV then
            local radius = Config.BulletFOVRadius or Config.BulletFOVCircleRadius or 180
            local diameter = radius * 2
            FOVCircle.Size = UDim2.new(0, diameter, 0, diameter)
            if AutoLockEnabled and CurrentTargetPart then
                FOVStroke.Color = T.Red; FOVStroke.Transparency = 0.15
            elseif Config.BulletTrackingEnabled then
                FOVStroke.Color = T.Cyan; FOVStroke.Transparency = 0.25
            else
                FOVStroke.Color = Config.BulletFOVCircleColor; FOVStroke.Transparency = 0.45
            end
            FOVCircle.Visible = true
        else
            FOVCircle.Visible = false
        end

        -- 3. Auto Shoot (TriggerBot)
        if Config.AutoShootEnabled then
            local shootTarget = GetAutoShootTarget()
            if shootTarget then
                TriggerShoot()
            end
        end

        -- 4. Bunny Hop Simulation
        if Config.BunnyHopEnabled then
            local myChar = LocalPlayer.Character
            local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
            if hum and hum.MoveDirection.Magnitude > 0 then
                hum.Jump = true
            end
        end

        -- 5. ESP Highlights Update
        if Config.HighlightAllEnabled then
            local myChar = LocalPlayer.Character
            local myRoot = myChar and GetTargetPart(myChar)
            if myRoot then
                local myPos = myRoot.Position
                local candidates = {}
                local checked = {}

                local function CheckModel(model)
                    if not model or not model:IsA("Model") or model == myChar or checked[model] then return end
                    checked[model] = true
                    if not IsValidEnemy(model) then return end
                    local isPlr, plrObj = IsPlayerCharacter(model)
                    if isPlr and Config.TeamCheck and IsSameTeam(plrObj) then return end
                    local allowed = (Config.HighlightTargetType == "All") or (Config.HighlightTargetType == "NPC" and not isPlr) or (Config.HighlightTargetType == "Player" and isPlr)
                    if not allowed then return end
                    local root = GetTargetPart(model)
                    if not root then return end
                    local targetPos = root.Position
                    if math.abs(targetPos.X - myPos.X) <= Config.HighlightRadiusX and math.abs(targetPos.Y - myPos.Y) <= Config.HighlightRadiusY and math.abs(targetPos.Z - myPos.Z) <= Config.HighlightRadiusZ then
                        local dist = (targetPos - myPos).Magnitude
                        local charName = isPlr and (plrObj.DisplayName ~= "" and plrObj.DisplayName or plrObj.Name) or model.Name
                        table.insert(candidates, {Model = model, Distance = dist, Name = charName, Humanoid = model:FindFirstChildOfClass("Humanoid")})
                    end
                end

                if Config.HighlightTargetType == "All" or Config.HighlightTargetType == "Player" then
                    for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer and p.Character then CheckModel(p.Character) end end
                end
                if Config.HighlightTargetType == "All" or Config.HighlightTargetType == "NPC" then
                    for _, child in ipairs(workspace:GetChildren()) do
                        if child:IsA("Model") then CheckModel(child)
                        elseif child:IsA("Folder") then
                            for _, sub in ipairs(child:GetChildren()) do if sub:IsA("Model") then CheckModel(sub) end end
                        end
                    end
                end

                table.sort(candidates, function(a, b) return a.Distance < b.Distance end)
                local seen = {}
                for i = 1, math.min(#candidates, 24) do
                    local entry = candidates[i]
                    local model = entry.Model
                    seen[model] = true
                    local isLocked = (model == CurrentTargetChar and AutoLockEnabled)

                    -- BillboardGui Info
                    local bb = HighlightInfoBillboards[model]
                    local headPart = model:FindFirstChild("Head") or GetTargetPart(model)
                    if headPart then
                        local hpVal = entry.Humanoid and math.max(0, math.floor(entry.Humanoid.Health)) or 0
                        local textContent = string.format("[%s]\n[%d HP]\n[%.0f studs]", entry.Name, hpVal, entry.Distance)
                        if not bb or not bb.Parent then
                            bb = Instance.new("BillboardGui")
                            bb.Name = "CombatHighlightInfoBB"
                            bb.Adornee = headPart
                            bb.Size = UDim2.new(0, 140, 0, 44)
                            bb.StudsOffset = Vector3.new(0, 2.4, 0)
                            bb.AlwaysOnTop = true
                            bb.MaxDistance = 1200
                            local lbl = Instance.new("TextLabel")
                            lbl.Name = "InfoLabel"
                            lbl.Size = UDim2.fromScale(1, 1)
                            lbl.BackgroundTransparency = 1
                            lbl.TextColor3 = isLocked and T.Red or T.Yellow
                            lbl.Font = F.Bold
                            lbl.TextSize = 9
                            lbl.Text = textContent
                            lbl.Parent = bb
                            pcall(function() bb.Parent = model end)
                            HighlightInfoBillboards[model] = bb
                        else
                            local lbl = bb:FindFirstChild("InfoLabel")
                            if lbl then
                                lbl.Text = textContent
                                lbl.TextColor3 = isLocked and T.Red or T.Yellow
                            end
                        end
                    end

                    -- Highlight instance
                    if not isLocked then
                        local hl = UnlockedHighlights[model]
                        if not hl or not hl.Parent then
                            hl = Instance.new("Highlight")
                            hl.Name = "CombatUnlockedHighlight"
                            hl.FillColor = Config.UnlockedHitboxColor
                            hl.FillTransparency = Config.UnlockedTransparency
                            hl.OutlineColor = Config.UnlockedOutlineColor
                            hl.OutlineTransparency = 0.2
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            hl.Adornee = model
                            pcall(function() hl.Parent = model end)
                            UnlockedHighlights[model] = hl
                        end
                    elseif UnlockedHighlights[model] then
                        pcall(function() UnlockedHighlights[model]:Destroy() end)
                        UnlockedHighlights[model] = nil
                    end
                end

                for char, hl in pairs(UnlockedHighlights) do
                    if not seen[char] or not char.Parent then pcall(function() hl:Destroy() end); UnlockedHighlights[char] = nil end
                end
                for char, bb in pairs(HighlightInfoBillboards) do
                    if not seen[char] or not char.Parent then pcall(function() bb:Destroy() end); HighlightInfoBillboards[char] = nil end
                end
            end
        end

        -- 6. AutoLock Camera Tracking & Character Orientation
        if not AutoLockEnabled then return end
        local myChar = LocalPlayer.Character
        local myRoot = myChar and GetTargetPart(myChar)
        if not myRoot then return end

        if Config.TargetSwitchMode == "Dynamic" then
            local best = FindBestTarget()
            if not CurrentTargetChar or not CurrentTargetPart or not IsValidEnemy(CurrentTargetChar) then
                SetTarget(best)
            else
                local curDist = (CurrentTargetPart.Position - myRoot.Position).Magnitude
                if curDist > Config.BreakDistance then SetTarget(best)
                elseif best and best.Character ~= CurrentTargetChar then
                    local newDist = (best.Part.Position - myRoot.Position).Magnitude
                    if newDist < (curDist - Config.SwitchDistanceMargin) then SetTarget(best) end
                end
            end
        else
            if not CurrentTargetChar or not CurrentTargetPart or not IsValidEnemy(CurrentTargetChar) then
                SetTarget(FindBestTarget())
            else
                local curDist = (CurrentTargetPart.Position - myRoot.Position).Magnitude
                if curDist > Config.BreakDistance then SetTarget(FindBestTarget()) end
            end
        end

        if CurrentTargetChar and IsValidEnemy(CurrentTargetChar) then
            CurrentTargetPart = GetTargetPart(CurrentTargetChar)
        end

        if CurrentTargetPart and CurrentTargetChar and IsValidEnemy(CurrentTargetChar) then
            local camPos = Camera.CFrame.Position
            local targetPos = CurrentTargetPart.Position
            if (targetPos - camPos).Magnitude > 0.01 then
                local targetCamCFrame = CFrame.new(camPos, targetPos)
                Camera.CFrame = Camera.CFrame:Lerp(targetCamCFrame, Config.CameraSmoothing)
            end
            if Config.AutoFaceCharacter then
                local lookVector = Vector3.new(targetPos.X, myRoot.Position.Y, targetPos.Z)
                if (lookVector - myRoot.Position).Magnitude > 0.01 then
                    local targetCharCFrame = CFrame.new(myRoot.Position, lookVector)
                    local oldVel = myRoot.AssemblyLinearVelocity
                    myRoot.CFrame = myRoot.CFrame:Lerp(targetCharCFrame, Config.CharacterFaceSpeed)
                    pcall(function() myRoot.AssemblyLinearVelocity = oldVel end)
                end
            end
        end
    end)
end)

