        floatDragging = true
        floatMoved = false
        floatDragStart = input.Position
        floatStartPos = floating.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                floatDragging = false
            end
        end)
    end
