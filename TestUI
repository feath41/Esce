local function GetSafeGuiParent(guiInstance)
    local targetParent = nil

    -- 1. Prioritas Utama untuk Delta Mobile, Arceus X, Codex, Wave, Hydrogen: gethui()
    pcall(function()
        if typeof(gethui) == "function" then
            targetParent = gethui()
        end
    end)

    -- 2. Proteksi syn.protect_gui jika didukung executor
    if guiInstance then
        pcall(function()
            if typeof(syn) == "table" and typeof(syn.protect_gui) == "function" then
                syn.protect_gui(guiInstance)
            end
        end)
    end

    -- 3. Fallback ke CoreGui jika executor memiliki izin
    if not targetParent then
        pcall(function()
            local coreGui = game:GetService("CoreGui")
            if coreGui then
                local testFolder = Instance.new("Folder")
                testFolder.Parent = coreGui
                testFolder:Destroy()
                targetParent = coreGui
            end
        end)
    end

    -- 4. Fallback aman ke PlayerGui (Roblox Studio / Non-Executor)
    if not targetParent then
        pcall(function()
            targetParent = player:WaitForChild("PlayerGui", 5) or (player and player.PlayerGui)
        end)
    end

    return targetParent or playerGui
end

