    -- Auto-adjust size connection when child components are added
    local function calculateContentHeight(): number
        if drawerLayout and drawerLayout.AbsoluteContentSize.Y > 0 then
            return drawerLayout.AbsoluteContentSize.Y + 20
        end
        local total = 20
        for _, child in ipairs(drawerContent:GetChildren()) do
            if child:IsA("GuiObject") and child.Visible then
                local h = child.AbsoluteSize.Y
                if h <= 0 then
                    h = child.Size.Y.Offset
