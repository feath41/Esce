        })
        tween(item.Icon, CONFIG.AnimSpeed.Standard, {
            TextColor3 = isActive and CONFIG.Theme.BrightBlue or CONFIG.Theme.TextSecondary
        })
    end

    -- Animate Page Transition (Smooth Slide + Fade)
    local oldPage = Pages[activePageName]
