    -- Header row inside card (Title + Current Value dynamic read)
    local titleLbl = Instance.new("TextLabel")
    titleLbl.Name = "Title"
    titleLbl.Size = UDim2.new(0.7, 0, 0, 16)
    titleLbl.Position = UDim2.new(0, 12, 0, 8)
