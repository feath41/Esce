    keyBtn.Position = UDim2.new(1, -122, 0.5, -13)
    keyBtn.BackgroundColor3 = CONFIG.Theme.Panel
    keyBtn.Text = "[ Key: " .. currentKey.Name .. " ]"
    keyBtn.TextColor3 = CONFIG.Theme.BrightBlue
    keyBtn.Font = CONFIG.Typography.Subheader
    keyBtn.TextSize = 11
    keyBtn.AutoButtonColor = false
    keyBtn.Parent = card
    applyCorner(keyBtn, 4)
    local btnStroke = applyStroke(keyBtn, CONFIG.Theme.Border, 1, 0.4)

    local listenerConnection: RBXScriptConnection? = nil

    local function stopListening()
        if listenerConnection then
            listenerConnection:Disconnect()
            listenerConnection = nil
        end
        isListening = false
        keyBtn.Text = "[ Key: " .. currentKey.Name .. " ]"
        keyBtn.TextColor3 = CONFIG.Theme.BrightBlue
        btnStroke.Color = CONFIG.Theme.Border
    end

    keyBtn.MouseButton1Click:Connect(function()
        if isListening then
            stopListening()
            return
        end

        isListening = true
        keyBtn.Text = "Press a key..."
        keyBtn.TextColor3 = CONFIG.Theme.Success
        btnStroke.Color = CONFIG.Theme.Success

        listenerConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                if input.KeyCode == Enum.KeyCode.Escape then
                    stopListening()
                    return
                end

                currentKey = input.KeyCode
                keyBtn.Text = "[ Key: " .. currentKey.Name .. " ]"
                keyBtn.TextColor3 = CONFIG.Theme.BrightBlue
                btnStroke.Color = CONFIG.Theme.PrimaryBlue

                -- Small confirmation punch animation
                tween(keyBtn, CONFIG.AnimSpeed.Micro, { BackgroundColor3 = CONFIG.Theme.AccentNavy })
                task.delay(0.15, function()
                    tween(keyBtn, CONFIG.AnimSpeed.Micro, { BackgroundColor3 = CONFIG.Theme.Panel })
                end)

                stopListening()
                Notify("Keybind Assigned", string.format("%s bound to %s", title, currentKey.Name), 2, "Success")
                if callback then
                    callback(currentKey)
                end
            end
        end)
    end)

    return {
        Card = card,
        GetKey = function() return currentKey end,
        SetKey = function(key: Enum.KeyCode)
            currentKey = key
            keyBtn.Text = "[ Key: " .. currentKey.Name .. " ]"
            if callback then callback(currentKey) end
        end
    }
end

