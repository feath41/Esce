    titleLbl.Parent = card

    local valueLbl = Instance.new("TextLabel")
    valueLbl.Name = "ValueLabel"
    valueLbl.Size = UDim2.new(0.3, -12, 0, 16)
    valueLbl.Position = UDim2.new(0.7, 0, 0, 8)
    valueLbl.BackgroundTransparency = 1
    valueLbl.Text = string.format("%.1f%s", currentValue, suffix)
    valueLbl.TextColor3 = CONFIG.Theme.BrightBlue
    valueLbl.Font = CONFIG.Typography.Header
    valueLbl.TextSize = 12
    valueLbl.TextXAlignment = Enum.TextXAlignment.Right
    valueLbl.Parent = card

    -- Slider Track
    local track = Instance.new("Frame")
    track.Name = "SliderTrack"
    track.Size = UDim2.new(1, -24, 0, 6)
    track.Position = UDim2.new(0, 12, 0, 34)
    track.BackgroundColor3 = CONFIG.Theme.Panel
    track.BorderSizePixel = 0
    track.Parent = card
    applyCorner(track, 3)
    applyStroke(track, CONFIG.Theme.TrackBorder, 1, 0.5)

    -- Fill Bar
    local fill = Instance.new("Frame")
    fill.Name = "Fill"
    local initialPercent = (currentValue - min) / (max - min)
    fill.Size = UDim2.new(initialPercent, 0, 1, 0)
    fill.BackgroundColor3 = CONFIG.Theme.PrimaryBlue
    fill.BorderSizePixel = 0
    fill.Parent = track
    applyCorner(fill, 3)

    -- Knob
    local knob = Instance.new("Frame")
    knob.Name = "Knob"
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = UDim2.new(1, -7, 0.5, -7)
    knob.BackgroundColor3 = CONFIG.Theme.KnobWhite
    knob.Parent = fill
    applyCorner(knob, 7)
    applyStroke(knob, CONFIG.Theme.PrimaryBlue, 1, 0.2)

    local isDragging = false

    local function updateFromInput(inputPos: Vector3)
        local trackAbsPos = track.AbsolutePosition
        local trackAbsSize = track.AbsoluteSize
        local relativeX = math.clamp(inputPos.X - trackAbsPos.X, 0, trackAbsSize.X)
        local percent = relativeX / trackAbsSize.X

        currentValue = min + ((max - min) * percent)
        -- Format to 1 decimal place
        currentValue = math.floor(currentValue * 10 + 0.5) / 10

        fill.Size = UDim2.new(percent, 0, 1, 0)
        valueLbl.Text = string.format("%.1f%s", currentValue, suffix)

        if callback then
            callback(currentValue)
        end
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            updateFromInput(input.Position)
            tween(knob, CONFIG.AnimSpeed.Micro, { Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(1, -8, 0.5, -8) })
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromInput(input.Position)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if isDragging then
                isDragging = false
                tween(knob, CONFIG.AnimSpeed.Micro, { Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(1, -7, 0.5, -7) })
            end
        end
    end)

    -- Hover effect
    card.MouseEnter:Connect(function()
        tween(stroke, CONFIG.AnimSpeed.Micro, { Color = CONFIG.Theme.BorderAccent })
        tween(card, CONFIG.AnimSpeed.Micro, { BackgroundColor3 = CONFIG.Theme.CardHover })
    end)
    card.MouseLeave:Connect(function()
        tween(stroke, CONFIG.AnimSpeed.Micro, { Color = CONFIG.Theme.Border })
        tween(card, CONFIG.AnimSpeed.Micro, { BackgroundColor3 = CONFIG.Theme.Card })
    end)

    return {
        Card = card,
        SetValue = function(val: number)
            currentValue = math.clamp(val, min, max)
            local percent = (currentValue - min) / (max - min)
            fill.Size = UDim2.new(percent, 0, 1, 0)
            valueLbl.Text = string.format("%.1f%s", currentValue, suffix)
            if callback then callback(currentValue) end
        end,
        GetValue = function(): number
            return currentValue
        end
    }
end

