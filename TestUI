-- Button Hover Interactions
local function bindButtonHover(btn: TextButton, defaultColor: Color3, hoverColor: Color3, hoverBg: Color3)
    btn.MouseEnter:Connect(function()
        tween(btn, CONFIG.AnimSpeed.Micro, {
            TextColor3 = hoverColor,
            BackgroundColor3 = hoverBg or CONFIG.Theme.Panel,
            BackgroundTransparency = 0
        })
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, CONFIG.AnimSpeed.Micro, {
            TextColor3 = defaultColor,
            BackgroundTransparency = 1
        })
    end)
end

