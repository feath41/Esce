local function SetMinimized(minimized: boolean)
    isMinimized = minimized
    if isMinimized then
        -- Collapse window to small title bar
        tween(BodyContainer, CONFIG.AnimSpeed.Standard, { BackgroundTransparency = 1 })
        BodyContainer.Visible = false
