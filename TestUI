    local existingInPlayerGui = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("ProjectNovaGui")
    if existingInPlayerGui then existingInPlayerGui:Destroy() end
end)

