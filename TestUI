local function GetSafeGuiParent(guiInstance: Instance?): Instance
    local targetParent = nil

    -- 1. Prioritas Utama untuk Delta Mobile, Arceus X, Codex, Hydrogen: gethui()
    pcall(function()
        if typeof(gethui) == "function" then
            targetParent = gethui()
        end
    end)

    -- 2. Proteksi syn.protect_gui jika didukung executor
    if guiInstance then
        pcall(function()
            if typeof(syn) == "table" and typeof(syn.protect_gui) == "function" then
                syn.protect_gui(guiInstance)
            end
        end)
    end

    -- 3. Fallback ke CoreGui jika executor memiliki izin
    if not targetParent then
        pcall(function()
            local coreGui = game:GetService("CoreGui")
            if coreGui then
                local testProbe = Instance.new("Folder")
                testProbe.Parent = coreGui
                testProbe:Destroy()
                targetParent = coreGui
            end
        end)
    end

    -- 4. Fallback standar ke PlayerGui (Roblox Studio / Game Biasa)
    if not targetParent then
        pcall(function()
            targetParent = LocalPlayer:WaitForChild("PlayerGui", 5) or (LocalPlayer and LocalPlayer.PlayerGui)
        end)
    end

    return targetParent or PlayerGui
end

local SafeParent = GetSafeGuiParent()

-- Safely destroy pre-existing instance if re-executing
