        tween(MainWindow, CONFIG.AnimSpeed.Drawer, { Size = UDim2.new(0, CONFIG.MinimizedSize.X, 0, CONFIG.MinimizedSize.Y) })
        tween(ShadowFrame, CONFIG.AnimSpeed.Drawer, { Size = UDim2.new(0, CONFIG.MinimizedSize.X + 16, 0, CONFIG.MinimizedSize.Y + 16) })
    else
        -- Restore full window
        ExpandBtn.Visible = false
        local expandTween = tween(MainWindow, CONFIG.AnimSpeed.Drawer, { Size = UDim2.new(0, CONFIG.WindowSize.X, 0, CONFIG.WindowSize.Y) })
        tween(ShadowFrame, CONFIG.AnimSpeed.Drawer, { Size = UDim2.new(0, CONFIG.WindowSize.X + 16, 0, CONFIG.WindowSize.Y + 16) })

        expandTween.Completed:Connect(function()
            if not isMinimized then
                BodyContainer.Visible = true
                StatusBar.Visible = true
            end
        end)
    end
end

