        tween(drawerContent, CONFIG.AnimSpeed.Drawer, { Size = UDim2.new(1, 0, 0, targetContentHeight) })
        tween(card, CONFIG.AnimSpeed.Drawer, { Size = UDim2.new(1, 0, 0, targetCardHeight) })
    end

    headerBtn.MouseButton1Click:Connect(function()
        toggleDrawer(not isExpanded)
    end)

    return {
        Card = card,
        Content = drawerContent,
        SetExpanded = toggleDrawer,
        IsExpanded = function() return isExpanded end,
        RefreshHeight = function()
            if isExpanded then
                local targetContentHeight = calculateContentHeight()
                drawerContent.Size = UDim2.new(1, 0, 0, targetContentHeight)
                card.Size = UDim2.new(1, 0, 0, headerHeight + targetContentHeight)
            end
        end
    }
end

