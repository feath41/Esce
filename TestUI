-- Function to dynamically change status
local function SetEngineStatus(stateName: string)
    stateName = string.upper(stateName)
    if stateName == "READY" then
        StatusValue.Text = "Ready"
        StatusValue.TextColor3 = CONFIG.Theme.Success
        tween(StatusDot, CONFIG.AnimSpeed.Standard, { BackgroundColor3 = CONFIG.Theme.Success })
    elseif stateName == "ACTIVE" then
        StatusValue.Text = "Active"
        StatusValue.TextColor3 = CONFIG.Theme.BrightBlue
        tween(StatusDot, CONFIG.AnimSpeed.Standard, { BackgroundColor3 = CONFIG.Theme.BrightBlue })
    elseif stateName == "DISABLED" then
        StatusValue.Text = "Disabled"
        StatusValue.TextColor3 = CONFIG.Theme.TextSecondary
        tween(StatusDot, CONFIG.AnimSpeed.Standard, { BackgroundColor3 = CONFIG.Theme.TextSecondary })
    elseif stateName == "ERROR" then
        StatusValue.Text = "Error"
        StatusValue.TextColor3 = CONFIG.Theme.Error
        tween(StatusDot, CONFIG.AnimSpeed.Standard, { BackgroundColor3 = CONFIG.Theme.Error })
    end
end

