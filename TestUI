-- System Toast Function
local function Notify(title: string, message: string, duration: number?, statusType: string?)
    duration = duration or 2.5
    statusType = statusType or "Success"

    local accentColor = CONFIG.Theme.PrimaryBlue
    local iconGlyph = "✓"

    if statusType == "Success" then
        accentColor = CONFIG.Theme.Success
        iconGlyph = "✓"
    elseif statusType == "Warning" then
        accentColor = CONFIG.Theme.Warning
        iconGlyph = "!"
    elseif statusType == "Error" then
        accentColor = CONFIG.Theme.Error
        iconGlyph = "✕"
    elseif statusType == "Info" then
        accentColor = CONFIG.Theme.BrightBlue
        iconGlyph = "⚡"
    end

    local toastFrame = Instance.new("Frame")
    toastFrame.Name = "Toast"
    toastFrame.Size = UDim2.new(1, 0, 0, 50)
    toastFrame.BackgroundColor3 = CONFIG.Theme.Card
    toastFrame.Position = UDim2.new(1, 40, 0, 0)
    toastFrame.BackgroundTransparency = 0.05
    toastFrame.ClipsDescendants = true
    toastFrame.Parent = ToastStack

    applyCorner(toastFrame, 6)
    local stroke = applyStroke(toastFrame, CONFIG.Theme.Border, 1, 0.2)

    -- Left Accent Ribbon
    local ribbon = Instance.new("Frame")
    ribbon.Name = "Ribbon"
    ribbon.Size = UDim2.new(0, 3, 1, 0)
    ribbon.BackgroundColor3 = accentColor
    ribbon.BorderSizePixel = 0
    ribbon.Parent = toastFrame

    -- Icon Emblem
    local iconBadge = Instance.new("TextLabel")
    iconBadge.Name = "IconBadge"
    iconBadge.Size = UDim2.new(0, 24, 0, 24)
    iconBadge.Position = UDim2.new(0, 12, 0.5, -12)
    iconBadge.BackgroundColor3 = CONFIG.Theme.SecondaryBackground
    iconBadge.TextColor3 = accentColor
    iconBadge.Text = iconGlyph
    iconBadge.TextSize = 13
    iconBadge.Font = CONFIG.Typography.Header
    iconBadge.Parent = toastFrame
    applyCorner(iconBadge, 12)
    applyStroke(iconBadge, accentColor, 1, 0.5)

    -- Title Label
    local titleLbl = Instance.new("TextLabel")
    titleLbl.Name = "Title"
    titleLbl.Size = UDim2.new(1, -50, 0, 16)
    titleLbl.Position = UDim2.new(0, 44, 0, 8)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = title
    titleLbl.TextColor3 = CONFIG.Theme.TextPrimary
    titleLbl.Font = CONFIG.Typography.Subheader
    titleLbl.TextSize = 12
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Parent = toastFrame

    -- Message Body
    local msgLbl = Instance.new("TextLabel")
    msgLbl.Name = "Message"
    msgLbl.Size = UDim2.new(1, -50, 0, 14)
    msgLbl.Position = UDim2.new(0, 44, 0, 25)
    msgLbl.BackgroundTransparency = 1
    msgLbl.Text = message
    msgLbl.TextColor3 = CONFIG.Theme.TextSecondary
    msgLbl.Font = CONFIG.Typography.Muted
    msgLbl.TextSize = 10
    msgLbl.TextXAlignment = Enum.TextXAlignment.Left
    msgLbl.TextTruncate = Enum.TextTruncate.AtEnd
    msgLbl.Parent = toastFrame

    -- Entry Animation: Slide In & Fade In
    toastFrame.Position = UDim2.new(1, 30, 0, 0)
    tween(toastFrame, CONFIG.AnimSpeed.Toast, { Position = UDim2.new(0, 0, 0, 0) })
    tween(stroke, CONFIG.AnimSpeed.Toast, { Color = accentColor })

    -- Automatic Cleanup
    task.delay(duration, function()
        if toastFrame and toastFrame.Parent then
            local exitTween = tween(toastFrame, CONFIG.AnimSpeed.Toast, {
                Position = UDim2.new(1, 60, 0, 0),
                BackgroundTransparency = 1
            })
            exitTween.Completed:Connect(function()
                toastFrame:Destroy()
            end)
        end
    end)
end

